# Copy to .env and fill in. Never commit real keys.
#
# Official Anthropic (preferred for --decision auto|llm):
ANTHROPIC_API_KEY=
# Optional override (leave empty for api.anthropic.com):
# ANTHROPIC_BASE_URL=

# Optional OpenAI-compatible gateway (used only if ANTHROPIC_API_KEY is empty):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional: path to okx CLI if not on PATH
# OKX_BIN=/usr/local/bin/okx
